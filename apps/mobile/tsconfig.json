{
  "extends": "../../packages/config-typescript/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "dist",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["@nativescript/types", "node"],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "references.d.ts",
    "nativescript.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "platforms", "hooks"]
}
